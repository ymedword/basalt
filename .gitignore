# 运行时工作区（`basalt init` 生成：SQLite 库 / 记忆 / 日志 / Agent 目录）——是数据，不入库
.basalt/

# 构建产物
/bin/
*.exe

# 本地临时工具、缓存、验证日志与参考素材
/tmp/

# 前端依赖目录（构建期依赖；dist 构建产物仍随源码提交，见约束 42）
assets/console/node_modules/

# 本地环境文件（凭证一律走 ${ENV_VAR}，明文不得落盘——万一写下也绝不入库）
*.local.env
.env

# 实例配置（与工作区同级；仓库只带样例 basalt.yaml.example——见 docs/Operations.md §6）
/basalt.yaml

# Development loop checkpoints, private command logs and generated eval reports
/.loop/
/evals/results/

# 发布打包输出（完整包 zip、报告与解压验证目录；由 scripts/release-package 生成）
/dist/

# Python 字节码缓存（示例脚本单测产生，不随仓库分发）
__pycache__/

# 官网仅在构建期使用；源图、锁文件和测试保留入库。
website/node_modules/
website/.vitepress/dist/
website/.vitepress/cache/
website/.vitepress/.temp/

# 示例运行产物与跨运行基线（每个 Demo 都在自己的目录下写 runs/<时间戳>/，
# D1 / D4 另写 state/；由每次运行生成，不随仓库分发。2026-10-25 T068 前统一口径：
# 原先只列 docs-diff / industry-brief 三条，本地跑其余 Demo 会凭空多出未跟踪文件。）
examples/daily/*/runs/
examples/daily/*/state/
