      ]
    },
    {
      "id": "T033",
      "checks": [
        "019-experience-authoring",
        "019-experience-demo",
        "019-experience-demo-controller"
      ]
    },
    {
      "id": "T034",
      "checks": [
        "019-experience-demo",
        "019-experience-demo-controller"
      ]
    },
    {
      "id": "T035",
      "checks": [
        "019-experience-console"
      ]
    },
    {
      "id": "T036",
      "checks": [
        "019-experience-authoring",
        "019-offline-model-policy"
      ]
    },
    {
      "id": "T037",
