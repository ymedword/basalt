{
  "version": 1,
  "id": "us18-aggregate",
  "approval": "User review 1 passed 2026-11-02 (US-18 R7/R8 module card). Implementation authorized; closeout awaits user review 2.",
  "inputs": [
    "docs/us/us18-docker-compose.md",
    "specs/018-docker-compose/spec.md",
    "specs/018-docker-compose/plan.md",
    "specs/018-docker-compose/tasks.md",
    "release/image-lock.json",
    "harness/acceptance.json"
  ],
  "protect": [
    "scripts/releasekit/image_test.go",
    "scripts/releasekit/imagelock_test.go",
    "scripts/releasekit/verify_test.go",
    "scripts/releasekit/assemble_image_test.go",
    "scripts/releasekit/docs_test.go",
    "cmd/basalt-verify/main_test.go",
    "internal/e2e/us18_image_test.go",
    "internal/e2e/us18_stack_test.go",
    "internal/e2e/us18_fixture_test.go",
    "internal/e2e/us18_container_test.go"
  ],
  "checks": [
    {
      "id": "us18-image-unit",
      "args": ["go", "test", "-json", "-count=1", "./scripts/releasekit", "./cmd/basalt-verify", "-run", "^TestUS18_(Image|Verify)_"],
      "timeout_seconds": 900,
      "required_tests": [
        "TestUS18_Image_RejectsPrivateKeyInContext",
        "TestUS18_Image_LockMatchesSources",
        "TestUS18_Image_RecordValidate",
        "TestUS18_Image_AssembleBindsRecord",
        "TestUS18_Verify_ImagesRecord",
        "TestUS18_Verify_RequireImageDigestFlag"
      ],
      "level": "source"
    },
    {
      "id": "us18-docs",
      "args": ["go", "test", "-json", "-count=1", "./scripts/releasekit", "-run", "^TestUS(17|18)_Docs_"],
      "timeout_seconds": 300,
      "required_tests": ["TestUS17_Docs_CommandsMatchCLI", "TestUS18_Docs_ImageCommands"],
      "level": "source"
    },
    {
      "id": "us18-compose-config",
      "args": ["go", "test", "-json", "-count=1", "-timeout=5m", "-tags=e2e", "./internal/e2e", "-run", "^TestUS18_Compose_ConfigRequiresSecrets$"],
      "timeout_seconds": 600,
      "required_tests": ["TestUS18_Compose_ConfigRequiresSecrets"],
      "level": "process"
    },
    {
      "id": "us18-image-build",
      "args": ["go", "test", "-json", "-count=1", "-timeout=20m", "-tags=e2e", "./internal/e2e", "-run", "^TestUS18_Image_"],
      "timeout_seconds": 1500,
      "required_tests": ["TestUS18_Image_BuildAndRecord"],
      "level": "process"
    },
    {
      "id": "us18-container-core",
      "args": ["go", "test", "-json", "-count=1", "-timeout=30m", "-tags=e2e", "./internal/e2e", "-run", "^TestUS18_Compose_(AdminLogin|TaskAndKnowledge|RecreatePreservesIdentity|GracefulShutdown)$"],
      "timeout_seconds": 2100,
      "required_tests": [
        "TestUS18_Compose_AdminLogin",
        "TestUS18_Compose_TaskAndKnowledge",
        "TestUS18_Compose_RecreatePreservesIdentity",
        "TestUS18_Compose_GracefulShutdown"
      ],
      "level": "process"
    },
    {
      "id": "us18-container-faults",
      "args": ["go", "test", "-json", "-count=1", "-timeout=30m", "-tags=e2e", "./internal/e2e", "-run", "^TestUS18_Compose_(DatabaseUnavailable|WrongCredentials|VolumePermissions|SecretPermissions|RestartDoesNotRerun|SecondInstanceRejected)$"],
      "timeout_seconds": 2100,
      "required_tests": [
        "TestUS18_Compose_DatabaseUnavailable",
        "TestUS18_Compose_WrongCredentials",
        "TestUS18_Compose_VolumePermissions",
        "TestUS18_Compose_SecretPermissions",
        "TestUS18_Compose_RestartDoesNotRerun",
        "TestUS18_Compose_SecondInstanceRejected"
      ],
      "level": "process"
    },
    {
      "id": "us18-backup-restore",
      "args": ["go", "test", "-json", "-count=1", "-timeout=30m", "-tags=e2e", "./internal/e2e", "-run", "^TestUS18_Compose_(BackupRestore|UpgradeRollback|RestoreRefusesExistingProject)$"],
      "timeout_seconds": 2100,
      "required_tests": ["TestUS18_Compose_BackupRestore", "TestUS18_Compose_UpgradeRollback", "TestUS18_Compose_RestoreRefusesExistingProject"],
      "level": "process"
    },
    {
      "id": "us18-cleanup",
      "args": ["go", "test", "-json", "-count=1", "-timeout=5m", "-tags=e2e", "./internal/e2e", "-run", "^TestUS18_Cleanup_NoResidue$"],
      "timeout_seconds": 600,
      "required_tests": ["TestUS18_Cleanup_NoResidue"],
      "level": "process"
    }
  ],
  "tasks": [
    {"id": "T047", "checks": ["us18-image-unit", "us18-docs"]},
    {"id": "T048", "checks": ["us18-compose-config"]},
    {"id": "T051", "checks": ["us18-image-unit", "us18-docs", "us18-compose-config", "us18-image-build", "us18-container-core", "us18-container-faults", "us18-backup-restore", "us18-cleanup"]},
    {"id": "T053", "checks": ["us18-image-unit", "us18-docs", "us18-container-core"]}
  ]
}
