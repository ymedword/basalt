# Basalt 单实例部署的示例环境变量：复制为 .env 后按需修改。
# **不得**把凭据写进这里——数据库口令只经 secrets/ 下的两个文件提供。
# Example deployment environment: copy to .env and adjust. Never put credentials
# here; the database password only travels through the two files under secrets/.

# 应用镜像：正式部署必须写「版本 + digest」，例如
#   BASALT_IMAGE=basalt:1.0.0@sha256:<64 位 hex>
# 只写 tag 的本地预演镜像可以用，但对外分发前必须换成 digest
# （basalt-verify --require-image-digest 判卷）。留空时 compose config 会点名失败。
# The app image must carry version + digest for a real deployment; a local rehearsal
# tag is accepted, but shipping requires a digest.
BASALT_IMAGE=

# 数据库镜像：compose 内以同一 digest 的字面量固定，本值供 `docker pull` 预取与
# 人工核对；release/image-lock.json 判卷要求两者逐字一致。
# The database image is pinned literally in compose.yaml; this value mirrors it for
# pre-pulling and manual checks, and the lock file rejects any drift.
BASALT_DB_IMAGE=pgvector/pgvector:0.8.7-pg17-bookworm@sha256:7d0a41464797aeb9862dfdc0bbf1526b82cfd324cdd8036df19e3545f4a9ccb8

# 宿主发布地址与端口：默认只发布到回环。改端口后**必须**同步修改
# /data/basalt.yaml 的 http.admin_auth.allowed_hosts / allowed_origins（U18-Q7）。
# Host bind and port; loopback by default. Changing the port requires editing the
# allowed_hosts / allowed_origins entries in /data/basalt.yaml as well.
BASALT_HTTP_BIND=127.0.0.1
BASALT_HTTP_PORT=8080

# 数据库名与用户：与 init-secrets.sh 生成 DSN 时的取值一致；改动后必须重新生成
# secrets/database_dsn（已有文件不会覆盖，需先人工删除并按轮换流程处理）。
# Database name and user; they must match the DSN generated by init-secrets.sh.
POSTGRES_DB=basalt
POSTGRES_USER=basalt

# 六项入口限流**必须**显式给出（产品不设默认，D-30）。以下仅是部署示例值，
# 不是产品推荐值；按实际流量与容量评估后调整。
# All six ingress limits are mandatory; the values below are deployment examples,
# not product defaults.
BASALT_INGRESS_RUN_QPS=10
BASALT_INGRESS_RUN_BURST=20
BASALT_INGRESS_INGEST_QPS=5
BASALT_INGRESS_INGEST_BURST=10
BASALT_INGRESS_READ_QPS=20
BASALT_INGRESS_READ_BURST=40
