# Basalt 多 Worker 部署的示例环境变量：复制为 .env 后按角色填写。
# Example environment for the multi-worker topology: copy to .env and fill per role.
#
# **不得**把凭据写进这里。密码与主密钥只经 `docker/secrets/` 下的文件提供：
#   database_dsn      init-secrets.sh 生成；Worker 侧用 --copy-from 复制并改主机
#   postgres_password init-secrets.sh 生成，只有控制面侧需要
#   master.key        export-master-key.sh 从控制面私有卷导出（0400、10001:10001）
# Never put credentials here: the password and the master key travel only through the
# three files under docker/secrets/.
#
# 两宿主各放一份：A 用完整的 control 组变量，B 只用 BASALT_IMAGE / 库名用户 /
# BASALT_WORKER_NAME（B 上没有控制面的 .env，也没有 postgres_password）。

# 应用镜像：正式部署写「版本 + digest」，例如 basalt:1.0.0@sha256:<64 位 hex>。
# 只写 tag 的本地预演镜像可以用于验证，对外分发前必须换成 digest。
# The app image must carry version + digest for a real deployment.
BASALT_IMAGE=

# 数据库镜像：编排里以同一 digest 的字面量固定，本值供 `docker pull` 预取与人工核对；
# release/image-lock.json 判卷要求两者逐字一致。
# The database image is pinned literally in the compose file; this mirrors it.
BASALT_DB_IMAGE=pgvector/pgvector:0.8.7-pg17-bookworm@sha256:7d0a41464797aeb9862dfdc0bbf1526b82cfd324cdd8036df19e3545f4a9ccb8

# PostgreSQL 的宿主绑定地址：单宿主用 127.0.0.1（只绑回环）；双宿主写 A 的**私网**
# 地址，并在安全组里只放行 B。这里的**私网**指 RFC1918 段（10/8、172.16/12、
# 192.168/16）或控制面宿主回环；预检只拒绝空值与 0.0.0.0，**不**代你判定地址是否
# 真的私网——写成公网地址会照常放行，这是部署纪律。**不得**留空、**不得**写
# 0.0.0.0——空值会被 Docker 当成“所有地址”；也**不得**写 IPv6 全地址 `[::]`（它与
# 0.0.0.0 等价，同样能把数据库暴露到每一块网卡）。Compose 的插值挡不住取值，这三条
# 由控制面 profile 的 basalt-preflight 在启动前挡下（不通过则 PostgreSQL 与控制面都
# 不启动）。
# Loopback on a single host; the control plane's RFC1918 address on a dual-host
# deployment. Never empty, never 0.0.0.0 and never IPv6 `[::]` — enforced by the
# preflight service; a public address passes the preflight and is a deployment error.
BASALT_DB_BIND=127.0.0.1

# 控制面 HTTP 发布地址与端口：默认只发布到回环。改端口后**必须**同步修改
# /data/basalt.yaml 的 http.admin_auth.allowed_hosts / allowed_origins。
# Host bind and port for the control plane; loopback by default.
BASALT_HTTP_BIND=127.0.0.1
BASALT_HTTP_PORT=8080

# 库名与用户：必须与 init-secrets.sh 生成 DSN 时的取值一致；改动后要重新生成
# secrets/database_dsn（已有文件不会覆盖）。
# Database name and user; they must match the DSN generated by init-secrets.sh.
POSTGRES_DB=basalt
POSTGRES_USER=basalt

# 六项入口限流：**只有控制面需要**，产品不设默认（D-30），缺任一项由 basalt-preflight
# 在启动前挡下。以下是部署示例值，不是产品推荐值；按实际流量与容量评估后调整。
# The six ingress limits are control-plane only; the preflight rejects missing values.
# The values below are examples, not product recommendations.
BASALT_INGRESS_RUN_QPS=10
BASALT_INGRESS_RUN_BURST=20
BASALT_INGRESS_INGEST_QPS=5
BASALT_INGRESS_INGEST_BURST=10
BASALT_INGRESS_READ_QPS=20
BASALT_INGRESS_READ_BURST=40

# Worker 诊断名：写进 worker_nodes 的展示列，**允许重复**——身份是实例标识，
# 不是这个名字。两个 Worker 想区分开就各写一个。
# Diagnostic name only, duplicates allowed; the identity is the instance id.
BASALT_WORKER_NAME=worker-a
