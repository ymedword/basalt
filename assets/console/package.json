{
  "name": "basalt-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Basalt 管理台前端（构建期产物经 go:embed 进入单二进制）",
  "engines": {
    "node": ">=24.22.0"
  },
