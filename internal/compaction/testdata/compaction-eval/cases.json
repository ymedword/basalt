{
  "dataset": "us16-compaction-arms",
  "version": 1,
  "label_status": "ai_adjudicated_not_human",
  "source": "AI judgement under the user's 2026-10-27 delegation (用户授权 Claude 代行技术评审与裁决); not human-labelled, not model-measured",
  "cases": [
    {
      "id": "goal-retention",
      "kind": "goal",
      "rationale": "目标保持：目标原话在早期消息里，最近组只保留交付物描述——用来暴露整组丢弃会丢掉目标",
      "compactions": 1,
      "messages": [
        {
          "role": "user",
          "content": "本轮目标：10 月 31 日前完成 Q3 财务对账，并把差异清单交给审计组。"
        },
        {
          "role": "assistant",
          "content": "收到。我先确认对账口径，再开始核对。"
        },
        {
          "role": "assistant",
          "content": "",
          "tool_calls": [
            {
              "id": "c1",
              "name": "source_view",
              "arguments": "{\"source_id\":\"kb-recon\"}"
            }
          ]
        },
        {
          "role": "tool",
          "tool_call_id": "c1",
          "content": "对账口径：以 ERP 导出为准；单笔差异超过 100 元必须逐条列示。"
        },
        {
          "role": "user",
          "content": "继续。"
        },
        {
          "role": "assistant",
          "content": "好的，我按上述口径继续核对。"
        },
        {
          "role": "user",
          "content": "差异清单要包含哪些字段？"
        },
        {
          "role": "assistant",
          "content": "包含单据号、金额、差异原因三项。"
        },
        {
          "role": "user",
          "content": "务必记住：交付物就是这份差异清单。"
        },
        {
          "role": "assistant",
          "content": "已记录，交付物为对账差异清单。"
        }
      ],
      "must_keep": [
        {
          "message": 0,
          "point": "10 月 31 日前完成 Q3 财务对账"
        },
        {
          "message": 8,
          "point": "交付物就是这份差异清单"
        }
      ]
    },
    {
      "id": "constraint-negation",
      "kind": "constraint_negation",
      "rationale": "硬约束与否定条件：约束用否定句写成原话，保留段里只有复述——用来暴露摘要改写否定的风险",
      "compactions": 1,
      "messages": [
        {
          "role": "user",
          "content": "硬约束：不得修改生产库，只能读只读副本。"
        },
        {
          "role": "assistant",
          "content": "明白，我只走只读副本。"
        },
        {
          "role": "assistant",
          "content": "",
          "tool_calls": [
            {
              "id": "c1",
              "name": "source_view",
              "arguments": "{\"source_id\":\"kb-db\"}"
            }
          ]
        },
        {
          "role": "tool",
          "tool_call_id": "c1",
          "content": "只读副本连接已就绪（连接串已脱敏，不落日志）。"
        },
        {
          "role": "user",
          "content": "也别忘了不能导出客户手机号。"
        },
        {
          "role": "assistant",
          "content": "收到，导出字段里剔除手机号。"
        },
        {
          "role": "user",
          "content": "再确认一次：不允许写操作。"
        },
        {
          "role": "assistant",
          "content": "确认：本轮不执行任何写操作。"
        },
        {
          "role": "user",
          "content": "还有：报告里的金额统一用万元。"
        },
        {
          "role": "assistant",
          "content": "已记录，金额统一万元。"
        }
      ],
      "must_keep": [
        {
          "message": 0,
          "point": "不得修改生产库"
        },
        {
          "message": 8,
          "point": "报告里的金额统一用万元"
        }
      ]
    },
    {
      "id": "number-unit",
