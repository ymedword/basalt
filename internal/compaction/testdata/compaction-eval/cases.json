          "point": "5000 元或 3 天"
        },
        {
          "message": 8,
          "point": "5000 元 / 72 小时"
        }
      ]
    },
    {
      "id": "open-items",
      "kind": "open_items",
      "rationale": "未决项：未决状态必须保持未决，保留段里只有一句复述——用来暴露「未决被写成已完成」的风险",
