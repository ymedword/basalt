<mxCell id="assistant" value="追加 assistant 消息&#xa;执行工具前先保存包含 tool_calls 的消息" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;fillColor=#fffdf8;strokeColor=#bfc9cc;fontColor=#202b30;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="620" height="78" as="geometry"/></mxCell>
<mxCell id="fatal" value="致命失败 → Run failed&#xa;模型、上下文或消息持久化的致命失败" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;fillColor=#f0eee7;strokeColor=#bfc9cc;fontColor=#202b30;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="815" y="720" width="485" height="78" as="geometry"/></mxCell>
