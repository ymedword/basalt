<mxCell id="provider" value="Provider protocol call&#xa;Lookup the frozen explicit Provider mapping" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;fillColor=#fffdf8;strokeColor=#bfc9cc;fontColor=#202b30;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="80" y="585" width="620" height="78" as="geometry"/></mxCell>
<mxCell id="model-terminal" value="llm_calls → success / failed&#xa;Update the same audit row after the call" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;fillColor=#fffdf8;strokeColor=#bfc9cc;fontColor=#202b30;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="815" y="585" width="485" height="78" as="geometry"/></mxCell>
<mxCell id="assistant" value="Persist assistant message&#xa;Persist tool_calls before any tool executes" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;fillColor=#fffdf8;strokeColor=#bfc9cc;fontColor=#202b30;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="620" height="78" as="geometry"/></mxCell>
