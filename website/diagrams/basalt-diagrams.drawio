<mxCell id="admission" value="准入与 Run 快照&#xa;生命周期 active、资格、并发与预算&#xa;固定本轮使用的已发布资源版本" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;fillColor=#fffdf8;strokeColor=#bfc9cc;fontColor=#202b30;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="80" y="305" width="620" height="96" as="geometry"/></mxCell>
<mxCell id="rejected" value="请求被拒绝&#xa;不发出模型或工具调用&#xa;请求拒绝不是 Run 的第五种终态" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;fillColor=#f0eee7;strokeColor=#bfc9cc;fontColor=#202b30;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="815" y="305" width="485" height="96" as="geometry"/></mxCell>
<mxCell id="prompt" value="PromptBuilder&#xa;组装上下文、保留约束、按完整交互组裁剪" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;fillColor=#fffdf8;strokeColor=#bfc9cc;fontColor=#202b30;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="80" y="450" width="620" height="78" as="geometry"/></mxCell>
<mxCell id="model-pending" value="llm_calls → pending&#xa;先预写；预写失败不发出模型请求" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;fillColor=#e9edf9;strokeColor=#244bd8;fontColor=#202b30;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="815" y="450" width="485" height="78" as="geometry"/></mxCell>
