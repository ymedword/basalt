<mxCell id="execute" value="Tool.Execute&#xa;Policy.Check → controlled action / CommandRunner&#xa;Tool timeout and bounded output" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;fillColor=#fffdf8;strokeColor=#bfc9cc;fontColor=#202b30;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="80" y="990" width="620" height="96" as="geometry"/></mxCell>
<mxCell id="tool-terminal" value="tool_invocations → success / failed&#xa;A policy denial is failed / sandbox_denied&#xa;Failure is feedback; the Run may continue" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;fillColor=#fffdf8;strokeColor=#bfc9cc;fontColor=#202b30;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="815" y="990" width="485" height="96" as="geometry"/></mxCell>
<mxCell id="result" value="Append tool result; check cancel and budgets&#xa;Next round rebuilds the prompt&#xa;Only ReActLoop appends assistant / tool messages" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;fillColor=#fffdf8;strokeColor=#bfc9cc;fontColor=#202b30;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="80" y="1140" width="620" height="96" as="geometry"/></mxCell>
<mxCell id="recovery" value="Crash recovery · instance lock required&#xa;pending audit → unknown; running Run → failed&#xa;Repair partial tool groups; no automatic replay&#xa;Management-operation recovery uses its own proof" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;fillColor=#f0eee7;strokeColor=#bfc9cc;fontColor=#202b30;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="815" y="1140" width="485" height="128" as="geometry"/></mxCell>
